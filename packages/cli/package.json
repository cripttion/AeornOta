{
  "name": "@aeron/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Publish and manage Aeron OTA updates (Expo/React Native and Flutter via Shorebird).",
  "bin": {
    "aeron": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
